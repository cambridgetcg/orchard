{
  "name": "orchard",
  "version": "0.1.0",
  "private": true,
  "description": "Grow iOS apps from existing web projects: doctor, templates, native bridge, Xcode Cloud and GitHub Actions release paths.",
  "type": "module",
  "bin": { "orchard": "bin/orchard" },
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:keychain": "ORCHARD_KEYCHAIN_TEST=1 node --test tests/keychain-roundtrip.test.mjs",
    "doctor": "node bin/orchard doctor"
  }
}
